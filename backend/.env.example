# Defaults to backend/data/cmh_sms.db when omitted.
# PostgreSQL example: postgresql+psycopg://user:password@localhost:5432/cmh_sms
CMH_SMS_DATABASE_URL=sqlite:///./data/cmh_sms.db

# Audio is generated and played only on the server PC connected to the PA.
CMH_SMS_AUDIO_ENABLED=true
CMH_SMS_SMS_GATEWAY_URL=
CMH_SMS_SMS_GATEWAY_TOKEN=
CMH_SMS_AUDIO_CACHE=./data/announcement-cache

# Optional: select the dedicated USB sound card on Linux.
# CMH_SMS_AUDIO_PLAY_COMMAND=aplay -D plughw:CARD=Device $file

# Optional public tunnel. Normal hospital operation uses wired LAN only.
CMH_SMS_NGROK=false

# Production PostgreSQL (run.sh creates these automatically in ../.env).
CMH_SMS_DATABASE_MODE=postgres
CMH_SMS_DATABASE_URL=postgresql+psycopg://cmh_sms:CHANGE_ME@127.0.0.1:5432/cmh_sms
CMH_SMS_ADMIN_USERNAME=admin
CMH_SMS_ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
CMH_SMS_SESSION_HOURS=12
CMH_SMS_ENVIRONMENT=development
# run.sh adds the detected LAN address in development. Production must list
# every approved hostname/IP explicitly.
CMH_SMS_ALLOWED_HOSTS=localhost,127.0.0.1
CMH_SMS_CORS_ORIGINS=
CMH_SMS_PUBLIC_HTTPS=false
CMH_SMS_COOKIE_SECURE=false
CMH_SMS_TLS_CERTFILE=
CMH_SMS_TLS_KEYFILE=
CMH_SMS_SEED_DEMO=false
